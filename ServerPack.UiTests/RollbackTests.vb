Imports System.IO
Imports System.Reflection
Imports Newtonsoft.Json.Linq
Imports PclServerPack

Module RollbackTests
    Public Sub Run(check As Action(Of Boolean, String), reject As Action(Of Action, String))
        Dim folder = Path.Combine(Path.GetTempPath(), "pcl-rollback-ui-" & Guid.NewGuid().ToString("N"))
        Directory.CreateDirectory(folder)
        Try
            Dim dep = "fabric-loader=0.16.0;minecraft=1.21.1"
            Dim root = GetInstanceRoot(folder, "alpha", "1.21.1", dep)
            Dim meta = Path.Combine(root, ".pcl-server-pack")
            Directory.CreateDirectory(meta)
            Dim id = New String("a"c, 32)
            Dim tx = Path.Combine(meta, "tx-" & id)
            Directory.CreateDirectory(tx)
            Dim state As New JObject(New JProperty("Format", 1), New JProperty("Version", "old"), New JProperty("DependencyKey", dep), New JProperty("Files", New JObject()))
            Dim fileRoot = Path.Combine(root, "mods")
            Directory.CreateDirectory(fileRoot)
            Dim targetFile = Path.Combine(fileRoot, "managed.jar")
            File.WriteAllText(targetFile, "after")
            File.WriteAllText(Path.Combine(tx, "before-0"), "before")
            Dim beforeHash = Convert.ToHexString(Security.Cryptography.SHA512.HashData(Text.Encoding.UTF8.GetBytes("before"))).ToLowerInvariant()
            Dim afterHash = Convert.ToHexString(Security.Cryptography.SHA512.HashData(Text.Encoding.UTF8.GetBytes("after"))).ToLowerInvariant()
            Dim changes As New JArray(New JObject(New JProperty("Path", "mods/managed.jar"), New JProperty("Before", beforeHash), New JProperty("After", afterHash), New JProperty("Backup", "before-0")))
            state("Files")("mods/managed.jar") = beforeHash
            Dim afterState = DirectCast(state.DeepClone(), JObject)
            afterState("Files")("mods/managed.jar") = afterHash
            File.WriteAllText(Path.Combine(meta, "state.json"), afterState.ToString())
            File.WriteAllText(Path.Combine(tx, "transaction.json"), New JObject(New JProperty("Id", id), New JProperty("Before", state), New JProperty("After", afterState), New JProperty("Changes", changes)).ToString())
            File.WriteAllText(Path.Combine(meta, "pending.json"), id)
            check(Not PackService.IsManaged(root), "fixture must be rejected by normal managed gate while pending")
            Dim method = GetType(ModServerPack).GetMethod("FindLocalRollbackRoots", BindingFlags.Public Or BindingFlags.Static)
            check(method IsNot Nothing, "rollback must resolve local pending instance without current mrpack preparation")
            Dim roots = DirectCast(method.Invoke(Nothing, New Object() {folder, "alpha"}), IList(Of String))
            check(roots.Count = 1 AndAlso roots(0) = root, "pending instance must remain locally reachable")
            File.Delete(Path.Combine(meta, "state.json"))
            roots = DirectCast(method.Invoke(Nothing, New Object() {folder, "alpha"}), IList(Of String))
            check(roots.Count = 1 AndAlso roots(0) = root, "missing state must use validated pending journal ownership")
            RunLockedServerMutationAsync(root, Sub() PackService.RollbackLast(root)).GetAwaiter().GetResult()
            check(Not File.Exists(Path.Combine(meta, "pending.json")) AndAlso PackService.IsManaged(root), "local UI helper path must allow real core journal recovery")
            check(File.ReadAllText(targetFile) = "before", "core journal recovery must actually restore managed bytes")
            File.WriteAllText(Path.Combine(meta, "pending.json"), id)
            File.WriteAllText(targetFile, "user edit")
            Try
                RunLockedServerMutationAsync(root, Sub() PackService.RollbackLast(root)).GetAwaiter().GetResult()
                check(False, "rollback must reject user edits")
            Catch ex As IOException
                check(File.ReadAllText(targetFile) = "user edit" AndAlso File.Exists(Path.Combine(meta, "pending.json")), "core conflicts must preserve user edits and pending journal")
            End Try
            File.WriteAllText(targetFile, "before")
            Dim validJournalText = File.ReadAllText(Path.Combine(tx, "transaction.json"))
            Dim malformedJournal = JObject.Parse(validJournalText)
            malformedJournal("Id") = New JArray("not-an-id")
            File.WriteAllText(Path.Combine(tx, "transaction.json"), malformedJournal.ToString())
            check(FindLocalRollbackRoots(folder, "alpha").Count = 0, "non-string journal ID must be ignored safely")
            File.WriteAllText(Path.Combine(tx, "transaction.json"), validJournalText)
            Dim malformed = GetInstanceRoot(folder, "alpha", "1.20.1", "minecraft=1.20.1")
            Dim badMeta = Path.Combine(malformed, ".pcl-server-pack")
            Directory.CreateDirectory(Path.Combine(badMeta, "tx-" & id))
            File.WriteAllText(Path.Combine(badMeta, "pending.json"), id)
            Dim invalidState = DirectCast(state.DeepClone(), JObject)
            invalidState("Format") = 2
            File.WriteAllText(Path.Combine(badMeta, "tx-" & id, "transaction.json"), New JObject(New JProperty("Id", id), New JProperty("Before", invalidState), New JProperty("After", invalidState.DeepClone()), New JProperty("Changes", New JArray())).ToString())
            roots = FindLocalRollbackRoots(folder, "alpha")
            check(roots.Count = 1 AndAlso roots(0) = root, "malformed candidate must not hide a valid pending recovery")
            File.WriteAllText(Path.Combine(badMeta, "tx-" & id, "transaction.json"), File.ReadAllText(Path.Combine(badMeta, "tx-" & id, "transaction.json")).Replace("""Format"": 2", """Format"": 9223372036854775807"))
            roots = FindLocalRollbackRoots(folder, "alpha")
            check(roots.Count = 1, "oversized format integer must not hide valid candidate")
            check(FindLocalRollbackRoots(folder, "beta").Count = 0, "other server must not match")
            check(FindLocalRollbackRoots(folder, "alph").Count = 0, "partial ID must not match")
            reject(Sub() FindLocalRollbackRoots(folder, "../alpha"), "unsafe server ID accepted")
            reject(Sub() FindLocalRollbackRoots("relative", "alpha"), "relative Minecraft root accepted")
            Dim journalText = File.ReadAllText(Path.Combine(tx, "transaction.json"))
            File.WriteAllText(Path.Combine(meta, "pending.json"), "../" & New String("a"c, 29))
            check(FindLocalRollbackRoots(folder, "alpha").Count = 0, "traversal transaction pointer accepted")
            File.WriteAllText(Path.Combine(meta, "pending.json"), id & vbLf)
            check(FindLocalRollbackRoots(folder, "alpha").Count = 0, "noncanonical transaction pointer accepted")
            File.WriteAllText(Path.Combine(meta, "pending.json"), id)
            File.WriteAllText(Path.Combine(tx, "transaction.json"), journalText.TrimEnd() & "{}")
            check(FindLocalRollbackRoots(folder, "alpha").Count = 0, "trailing journal content accepted")
            File.WriteAllText(Path.Combine(tx, "transaction.json"), journalText)
            Dim secondDep = "minecraft=1.20.4;neoforge=20.4.1"
            Dim second = GetInstanceRoot(folder, "alpha", "1.20.4", secondDep)
            Dim secondMeta = Path.Combine(second, ".pcl-server-pack")
            Directory.CreateDirectory(Path.Combine(secondMeta, "tx-" & id))
            File.WriteAllText(Path.Combine(secondMeta, "state.json"), state.ToString().Replace(dep, secondDep))
            File.WriteAllText(Path.Combine(secondMeta, "last.json"), id)
            File.WriteAllText(Path.Combine(secondMeta, "tx-" & id, "transaction.json"), journalText.Replace(dep, secondDep))
            roots = FindLocalRollbackRoots(folder, "alpha")
            check(roots.Count = 2 AndAlso roots.Contains(root) AndAlso roots.Contains(second), "all own versions must be returned for explicit UI selection")
            check(roots.SequenceEqual(roots.OrderBy(Function(p) p, StringComparer.Ordinal)), "multiple candidates must have deterministic order")
            Dim overlap = GetInstanceRoot(folder, "alpha-other", "1.21.1", dep)
            Dim overlapMeta = Path.Combine(overlap, ".pcl-server-pack")
            Directory.CreateDirectory(Path.Combine(overlapMeta, "tx-" & id))
            File.WriteAllText(Path.Combine(overlapMeta, "pending.json"), id)
            File.WriteAllText(Path.Combine(overlapMeta, "tx-" & id, "transaction.json"), journalText)
            check(FindLocalRollbackRoots(folder, "alpha").Count = 2, "overlapping server ID must not match prefix alone")
            check(FindLocalRollbackRoots(folder, "alpha-other").Count = 1, "exact hyphenated server ID must match")
            Dim link = Path.Combine(folder, "versions", GetInstanceName("alpha", "1.19.4", "minecraft=1.19.4"))
            Directory.CreateSymbolicLink(link, root)
            check(Not FindLocalRollbackRoots(folder, "alpha").Contains(link), "linked instance candidate accepted")
            Dim realJournal = Path.Combine(tx, "transaction.json")
            File.Move(realJournal, realJournal & ".saved")
            File.CreateSymbolicLink(realJournal, realJournal & ".saved")
            check(Not FindLocalRollbackRoots(folder, "alpha").Contains(root), "linked transaction journal accepted")
            File.Delete(realJournal)
            File.Move(realJournal & ".saved", realJournal)
            Dim nestedRoot = Path.Combine(folder, "versions", "unowned", GetInstanceName("alpha", "1.18.2", "minecraft=1.18.2"))
            Directory.CreateDirectory(Path.Combine(nestedRoot, ".pcl-server-pack"))
            check(FindLocalRollbackRoots(folder, "alpha").Count = 2, "discovery must not recurse into unknown versions")
            File.Delete(Path.Combine(secondMeta, "state.json"))
            check(Not FindLocalRollbackRoots(folder, "alpha").Contains(second), "completed rollback without state must not be adopted")
        Finally
            Directory.Delete(folder, True)
        End Try
    End Sub
End Module
