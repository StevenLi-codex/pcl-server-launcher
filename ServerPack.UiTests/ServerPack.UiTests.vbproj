<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><RootNamespace></RootNamespace><OptionStrict>On</OptionStrict></PropertyGroup>
  <ItemGroup>
    <Compile Include="../Plain Craft Launcher 2/Modules/ModServerPack.vb" Link="ModServerPack.vb" />
    <ProjectReference Include="CoreHarness/CoreHarness.csproj" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</HintPath></Reference>
    <None Include="../serverpack/catalog.json" Link="serverpack/catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
